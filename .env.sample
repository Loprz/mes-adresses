# US National Address Platform - Environment Configuration
# Copy this file to .env and fill in your values

# Core Platform URLs (will be US-hosted services)
NEXT_PUBLIC_EDITEUR_URL=http://localhost:3000
NEXT_PUBLIC_BAL_API_URL=http://localhost:5050/v2
NEXT_PUBLIC_GEO_API_URL=
NEXT_PUBLIC_ADRESSE_URL=
NEXT_PUBLIC_API_BAN_URL=
NEXT_PUBLIC_BAN_API_DEPOT=
NEXT_PUBLIC_MOISSONNEUR_BAL_API_URL=

# Video/Tutorial hosting
NEXT_PUBLIC_PEERTUBE=

# Analytics
NEXT_PUBLIC_MATOMO_SITE_ID=
NEXT_PUBLIC_MATOMO_TRACKER_URL=

# Admin
NEXT_PUBLIC_BAL_ADMIN_URL=
NEXT_PUBLIC_API_SIGNALEMENT=

# Directory APIs (US equivalents TBD)
NEXT_API_ANNUAIRE=

# Server
PORT=3000

# Integrations
MATTERMOST_TOKEN=
MATTERMOST_CHANNEL_URL=
NEXT_PUBLIC_BAL_WIDGET_URL=

# Error tracking
SENTRY_ENABLED=false

# Street-level imagery (optional)
NEXT_PUBLIC_PANORAMAX_API_ENDPOINT=

# Municipality directory (US equivalent TBD)
NEXT_PUBLIC_API_ANNUAIRE_DES_COLLECTIVITES=

# US Map Tile Configuration
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.stadiamaps.com/styles/osm_bright.json
NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.stadiamaps.com/fonts/{fontstack}/{range}.pbf
